{
  // Deploy: npm run yearbook:deploy (needs CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID and a finished ingest).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "crownjacobs77-yearbooks",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../.yearbook-build/assets",
    "binding": "ASSETS",
    // Every request goes through the signature check first; nothing is public.
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
