# ---- Phase 1: site gate (SPEC §12.1) ----
# preview = passcode-gated + noindex. production = public (set only at launch).
SITE_STAGE=preview
# Shared class passcode. Case and extra spaces are ignored. Use a phrase, not 4 digits.
SITE_PASSCODE=
# 32+ random characters. Generate with: openssl rand -base64 48
# Changing SITE_PASSCODE or this secret signs every device out.
SITE_GATE_SECRET=

# Canonical origin for calendar files and structured data.
NEXT_PUBLIC_SITE_URL=https://crownjacobs77.com

# ---- Phase 2: database (SPEC §3) ----
# Supabase → Project Settings → API. The anon/publishable key is fine server-side:
# Row Level Security limits it to public content. (The Supabase↔Vercel integration's
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY names also work.)
# Unset in preview = the site falls back to the SPEC §6 seed. Unset in production = error.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Lets admin saves / tests / a DB webhook refresh pages instantly (otherwise ≤ 60 s). 16+ chars.
REVALIDATE_SECRET=
# Vercel sends this to /api/cron/keepalive daily so a free Supabase project never pauses.
CRON_SECRET=

# ---- Later phases (not used yet) ----
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CRON_SECRET=
